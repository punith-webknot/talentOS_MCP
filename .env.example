TALENTOS_API_TIMEOUT=30
PORT=8000

# Infra docker-compose injects these two. TALENTOS_BACKEND_URL must point at
# talentos-backend (e.g. http://be:8001 inside Docker). TALENTOS_BACKEND_TOKEN
# is a Bearer credential (a tenant HR user's JWT, or a `tal_` API key once the
# backend allows keys to create hiring requests) — the backend rejects calls
# without an Authorization header.
TALENTOS_BACKEND_URL=http://be:8001
TALENTOS_BACKEND_TOKEN=

# Local dev fallback (kept for setups that still use the old var name).
# If you are running locally on host system:
# TALENTOS_API_BASE_URL= http://127.0.0.1:8001/

#If you are running the mcp server in a docker container, and talentOS backend server is running locally on host system
# TALENTOS_API_BASE_URL= http://host.docker.internal:8001/

#If you are running both mcp-server & talentOS backend server in a docker container on a same docker network
# TALENTOS_API_BASE_URL=http://<talentos-backend-container-name>:8001/